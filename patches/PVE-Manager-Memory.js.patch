+    validateVirtioMem: function () {
+        let pool = this.down('field[name=virtio-mem]')?.getValue() || 0;
+        if (pool === 0) {
+            return true;
+        }
+        let memory = this.down('field[name=memory]')?.getValue();
+        let minimum = this.down('field[name=balloon]')?.getValue();
+        let ballooning = this.down('field[name=ballooning]')?.getValue();
+        if (memory === undefined || minimum === undefined || ballooning === undefined) {
+            return true;
+        }
+        if (!ballooning) {
+            return gettext('virtio-mem requires the ballooning device for statistics.');
+        }
+        if (pool <= 0 || memory - pool < 1024) {
+            return gettext('virtio-mem must leave at least 1024 MiB of fixed memory.');
+        }
+        if (memory % 2 || pool % 2 || minimum % 2) {
+            return gettext('virtio-mem memory values must be multiples of 2 MiB.');
+        }
+        if (minimum < memory - pool || minimum > memory) {
+            return gettext('Minimum memory must be between fixed memory and maximum memory.');
+        }
+        return true;
+    },
+
+    validateVirtioMemFields: function () {
+        ['memory', 'balloon', 'virtio-mem'].forEach((name) => {
+            this.down('field[name=' + name + ']')?.validate();
+        });
+    },
