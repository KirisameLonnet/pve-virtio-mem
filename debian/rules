#!/usr/bin/make -f
%:
	dh $@
override_dh_auto_build:
	true
override_dh_auto_clean:
	true
override_dh_auto_test:
	make test
override_dh_auto_install:
	install -d debian/pve-virtio-mem/usr/share/pve-virtio-mem/patches
	install -m 644 patches/*.patch debian/pve-virtio-mem/usr/share/pve-virtio-mem/patches/
	install -d debian/pve-virtio-mem/usr/share/perl5/PVE/QemuServer
	install -m 644 tools/VirtioMem.pm debian/pve-virtio-mem/usr/share/perl5/PVE/QemuServer/
	install -d debian/pve-virtio-mem/usr/sbin
	install -m 755 tools/pve-virtio-mem-patch debian/pve-virtio-mem/usr/sbin/

override_dh_installdocs:
	dh_installdocs README.md LICENSE LICENSES/AGPL-3.0-or-later.txt
