new file mode 100644
index 000000000..4202b3b16
--- /dev/null
+++ b/mm/llfree/Kconfig
@@ -0,0 +1,9 @@
+config LLFREE
+	bool "Shared shadow bitmap for transparent memory reclaim"
+	depends on X86_64 && SPARSEMEM && SLUB
+	depends on !MEMORY_HOTPLUG && !CMA && !HUGETLBFS && !ZONE_DEVICE
+	depends on !COMPACTION && !PREEMPT_RT && !PAGE_POISONING
+	help
+	  Keep Linux's native buddy/PCP allocator. Track allocations and frees
+	  in shared metadata for the downstream virtio reclaim device.
+	  This is an experimental fixed-memory guest configuration.
