@@ -0,0 +1,18 @@
+#ifndef _LLFREE_ALLOC_H
+#define _LLFREE_ALLOC_H
+#include <linux/init.h>
+struct page;
+#ifdef CONFIG_LLFREE
+#include <llfree.h>
+llfree_t *__init llfree_node_init(size_t node, size_t cores, size_t start_pfn, size_t pages);
+void __init llfree_shadow_init(void);
+void llfree_track_alloc(struct page *page, unsigned int order);
+struct zone;
+void ll_request_install(struct zone *zone, uint64_t frame, size_t core);
+void llfree_track_free(struct page *page, unsigned int order);
+#else
+static inline void llfree_shadow_init(void) {}
+static inline void llfree_track_alloc(struct page *page, unsigned int order) {}
+static inline void llfree_track_free(struct page *page, unsigned int order) {}
+#endif
+#endif
